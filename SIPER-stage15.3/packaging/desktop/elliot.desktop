[Desktop Entry]
Type=Application
Version=1.0
Name=Siper Security Monitor
Name[tr]=Siper Güvenlik İzleyicisi
Comment=Unprivileged monitor for the Siper Pardus security daemon developed under the ELLIOT project
Comment[tr]=ELLIOT projesi kapsamında geliştirilen Siper Pardus güvenlik daemonu için kullanıcı arayüzü
Exec=/usr/local/bin/elliot-gui
Icon=security-high
Terminal=false
Categories=System;Security;
StartupNotify=true
