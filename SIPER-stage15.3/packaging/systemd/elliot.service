[Unit]
Description=Siper Pardus security daemon (ELLIOT project)
Documentation=file:/opt/elliot/current/README.md
After=local-fs.target systemd-udevd.service
Wants=local-fs.target
StartLimitIntervalSec=60
StartLimitBurst=5
ConditionPathExists=/opt/elliot/current/.venv/bin/siper-daemon

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/opt/elliot/current
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=ELLIOT_UPDATE_MANIFEST_URL=https://raw.githubusercontent.com/mustafaoyan/Elyra/main/landing/update-manifest.json
ExecStartPre=/opt/elliot/current/.venv/bin/siper-preflight --service
ExecStart=/opt/elliot/current/.venv/bin/siper-daemon
Restart=on-failure
RestartSec=3s
TimeoutStartSec=30s
TimeoutStopSec=20s
KillSignal=SIGTERM
UMask=0077
RuntimeDirectory=elliot
RuntimeDirectoryMode=0750
RuntimeDirectoryPreserve=no
StateDirectory=elliot
StateDirectoryMode=0700
LogsDirectory=elliot
LogsDirectoryMode=0750
LimitNOFILE=65536
TasksMax=512
LockPersonality=yes
RestrictSUIDSGID=yes

[Install]
WantedBy=multi-user.target
Alias=siper.service
